# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=          # server only, never imported client side

# Notion. Leave NOTION_TOKEN unset to run the app with sync disabled.
NOTION_TOKEN=                        # internal integration token
NOTION_ITEMS_DATABASE_ID=
NOTION_LOCATIONS_DATABASE_ID=
NOTION_WEBHOOK_VERIFICATION_TOKEN=   # captured during the one time handshake

# Required on /api/sync/* except the webhook, which authenticates by HMAC.
CRON_SECRET=
APP_URL=http://localhost:3000
